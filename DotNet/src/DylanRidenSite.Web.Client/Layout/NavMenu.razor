@inject NavigationManager Navigation

<!-- Apply the 'nav-container' class for styling -->
<div class="nav-container">
    <FluentAnchor Appearance="Appearance.Hypertext" class="nav-link" onclick="@(NavigateHome)">
        Home
    </FluentAnchor>

    <FluentAnchor Appearance="Appearance.Hypertext" class="nav-link" onclick="@(NavigateToProjects)">
        Projects
    </FluentAnchor>


    <FluentAnchor Appearance="Appearance.Hypertext" class="nav-link nav-resume" Href="/resources/dylan-riden-cv-02-2025.pdf" target="_blank" rel="noopener noreferrer">
        <span>
            Resume/CV
        <FluentEmoji Value="@(new Emojis.Objects.Color.Default.PageFacingUp())" class="nav-emoji"/>
        </span>
    </FluentAnchor>
 
    
</div>

@code {
    
    private void NavigateToProjects()
    {
        Navigation.NavigateTo("/projects");
    }

    private void NavigateHome()
    {
        Navigation.NavigateTo("/");
    }
}